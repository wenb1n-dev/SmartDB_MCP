# Database configuration file path
DATABASE_CONFIG_FILE=/path/to/src/config/database_config.json

#========Server========
# Server listen host
SERVER_HOST=0.0.0.0
# Server listen port
SERVER_PORT=3000

#========OAuth2========
# OAuth2 client ID
CLIENT_ID=your_client_id
# OAuth2 client secret
CLIENT_SECRET=your_client_secret
# Access token expiration time (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiration time (days)
REFRESH_TOKEN_EXPIRE_DAYS=30
# Token encryption key
TOKEN_SECRET_KEY=your_token_secret_key
# Username
OAUTH_USER_NAME=admin
# Password
OAUTH_USER_PASSWORD=your_password
